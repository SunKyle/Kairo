{
  "name": "kairo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:server": "PORT=3100 node --watch server/index.js",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "probe:chat-photo": "node scripts/probe-chat-photo.mjs",
    "check:server": "node scripts/check-server.mjs",
    "smoke:api": "node scripts/smoke-api.mjs",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "dev:lan": "LAN=1 npm run dev"
  },
  "dependencies": {
    "@fontsource/pacifico": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@phosphor-icons/vue": "^2.2.1",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "fflate": "^0.8.3",
    "motion": "^13.4.3",
    "simple-icons": "^16.33.0",
    "undici": "^7.29.1",
    "vue": "^3.5.12"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.1.4",
    "concurrently": "^9.0.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.8",
    "vitest": "^2.1.9",
    "vue-tsc": "^2.1.6"
  }
}
